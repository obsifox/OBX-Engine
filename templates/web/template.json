{
  "id": "web",
  "name": "Web Export",
  "kind": "template",
  "description": "Browser-ready shell with web runtime",
  "files": {
    "project.json": "{\n  \"format\": 2,\n  \"name\": \"{name}\",\n  \"version\": \"0.1.0\",\n  \"engine\": \"1.0.0\",\n  \"dependencies\": [],\n  \"settings\": {\n    \"language\": \"en\",\n    \"template\": \"web\"\n  },\n  \"plugins\": []\n}",
    "src/main.js": "const systems = [];\n  systems.push(\"ui\");\n  systems.push(\"runtime\");\n\nfunction start() {\n  return { name: \"Web Export\", systems };\n}\n\nmodule.exports = { start };\n",
    "assets/.keep": "",
    "scenes/.keep": "",
    "scripts/.keep": ""
  }
}
