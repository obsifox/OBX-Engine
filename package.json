{
  "name": "obx-engine",
  "version": "1.3.0",
  "private": true,
  "description": "OBX Engine \u2014 a cross-platform TypeScript game & application engine",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "core",
    "platform",
    "jobs",
    "vfs",
    "resources",
    "runtime",
    "ecs",
    "engine",
    "math",
    "input",
    "rendering",
    "graphics",
    "assets",
    "scene",
    "physics",
    "audio",
    "animation",
    "character",
    "ui",
    "save",
    "vehicle",
    "particles",
    "vfx",
    "ai",
    "navigation",
    "world",
    "extensions",
    "project",
    "networking",
    "server",
    "cli",
    "builder",
    "multiplayer",
    "profiler",
    "plugins",
    "registry",
    "editor",
    "native",
    "scripting",
    "obsiscript",
    "quest",
    "dialogue",
    "inventory",
    "tests/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b core runtime ecs engine math input rendering scene physics audio animation character ui save vehicle particles vfx",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b core runtime ecs engine math input rendering scene --pretty",
    "example:hello": "npm run build && node examples/hello-engine/index.js",
    "example:ecs": "npm run build && node examples/ecs-demo/index.js",
    "example:twod": "npm run build && node examples/twod-demo/index.js",
    "example:threed": "npm run build && node examples/threed-demo/index.js",
    "example:v05": "npm run build && node examples/v05-demo/index.js",
    "example:v06": "npm run build && node examples/v06-demo/index.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
